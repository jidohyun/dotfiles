          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "rosakodu.dock"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "tech.greyforge.reprieve"
        },
        {
          "id": "shavanced.notification-center"
        },
        {
          "id": "akitaonrails.ai-usagebar",
