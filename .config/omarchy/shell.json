        {
          "id": "omarchy.menu"
        },
        {
          "id": "greyforge.hotbar"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "user.fcitx-state"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
